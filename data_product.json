---
layout: none
permalink: /data_product.json
---

{
  "product": [
    {% assign items = site.posts %}
    {% for item in items %}
      {
        "slug": {{ item.title | slugify | jsonify }},
        "url": {{ item.url | jsonify }},
        "title": {{ item.title | jsonify }},
        "sku": {{ item.code | default: "" | jsonify }},
        "price": {{ item.price | jsonify }},
        "discount": {{ item.discount | jsonify }},
        "stock": {{ item.stock |jsonify }},
        "description": {{ item.description | strip_html | strip_newlines | jsonify }},
        "image": {{ item.featured_image_path | jsonify }},
        "styles": [
          {% for style in item.styles %}
            {
              "name": {{ style.name | jsonify }},
              "color": {{ style.color | jsonify }},
              "image_path": {{ style.image_path | jsonify }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}