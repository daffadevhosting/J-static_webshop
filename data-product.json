---
layout: none
permalink: /data-product.json
---
[
  {% for post in site.posts %}
  {
    "code": {{ post.code | jsonify }},
    "title": {{ post.title | jsonify }},
    "description": {{ post.description | jsonify }},
    "categories": {{ post.categories | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "price": {{ post.price | jsonify }},
    "stock": {{ post.stock | jsonify }},
    "sizes": {{ post.sizes | jsonify }},
    "styles": {{ post.styles | jsonify }},
    "featured_image_path": {{ post.featured_image_path | jsonify }},
    "facebook_image_path": {{ post.facebook_image_path | jsonify }},
    "content": {{ post.content | strip_newlines | strip | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
